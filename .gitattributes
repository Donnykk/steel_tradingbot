# Auto-detect text files and perform LF normalization
* text=auto

# Explicitly declare text files to ensure they are normalized
*.py text eol=lf
*.md text
*.txt text
*.json text
*.js text
*.html text
*.css text

# Declare binary files so they are not normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
